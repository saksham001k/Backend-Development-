<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add a Task</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <h1>Add a Task</h1>
  <p><a href="/">Back to tasks</a></p>
  <% if (error) { %>
    <p role="alert"><%= error %></p>
  <% } %>
  <form action="/tasks" method="POST">
    <p>
      <label for="title">Title</label>
      <input id="title" name="title" value="<%= values.title %>" required>
    </p>
    <p>
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="4"><%= values.description %></textarea>
    </p>
    <p>
      <label><input type="checkbox" name="isUrgent" <%= values.isUrgent ? "checked" : "" %>> Urgent</label>
    </p>
    <p>
      <label><input type="checkbox" name="isImportant" <%= values.isImportant ? "checked" : "" %>> Important</label>
    </p>
    <button type="submit">Save Task</button>
  </form>
  <footer><p>Saksham Katiyar · SAP ID: 590015169</p></footer>
</body>
</html>
