<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/style.css"></head><body><main><h1><%= title %></h1><table><thead><tr><th>ID</th><th>Name</th><th>Branch</th></tr></thead><tbody><% students.forEach((student, index) => { %><tr class="<%= index % 2 === 0 ? 'even' : 'odd' %>"><td><%= student.id %></td><td><%= student.name %></td><td><%= student.branch %></td></tr><% }) %></tbody></table><a href="/about">About</a></main></body></html>
